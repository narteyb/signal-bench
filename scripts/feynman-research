#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

if [[ -n "${FEYNMAN_BIN:-}" ]]; then
  FEYNMAN="${FEYNMAN_BIN}"
elif command -v feynman >/dev/null 2>&1; then
  FEYNMAN="$(command -v feynman)"
elif [[ -x "${HOME}/.local/bin/feynman" ]]; then
  FEYNMAN="${HOME}/.local/bin/feynman"
else
  echo "feynman not found. Install it or set FEYNMAN_BIN=/path/to/feynman." >&2
  exit 127
fi

exec "${FEYNMAN}" --cwd "${REPO_ROOT}" "$@"
